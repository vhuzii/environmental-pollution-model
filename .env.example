# Скопіюйте цей файл у .env. Усі змінні необов'язкові для запуску розрахунку.
# OpenAQ не потрібен для гаусової моделі. Ключ отримують на https://explore.openaq.org/register

OPENAQ_API_KEY=
OPENAQ_BASE_URL=https://api.openaq.org/v3
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
REQUEST_TIMEOUT_SECONDS=15
